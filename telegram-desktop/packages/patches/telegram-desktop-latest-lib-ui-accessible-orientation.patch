Drop QAccessible::Attribute::Orientation reporting.

QAccessible::Attribute::Orientation is not yet present in Qt 6.9.2, so
ui/accessible/ui_accessible_widget.cpp fails to compile there. The
feature only affects the AttributesInterface a screen reader queries on
Windows (UI Automation); dropping it is safe on this platform.

Path-adjusted for telegram-desktop/latest's single recursive-submodule
checkout: lib_ui now lives at Telegram/lib_ui instead of being its own
checkout root (see lib-ui-for-telegram-accessible-orientation.patch for
the original).

--- a/Telegram/lib_ui/ui/accessible/ui_accessible_widget.cpp
+++ b/Telegram/lib_ui/ui/accessible/ui_accessible_widget.cpp
@@ -95,10 +95,6 @@
 		&& rp()->accessibilitySelectionList()) {
 		return static_cast<QAccessibleSelectionInterface*>(this);
 	}
-	if (type == QAccessible::AttributesInterface
-		&& rp()->accessibilityOrientation().has_value()) {
-		return static_cast<QAccessibleAttributesInterface*>(this);
-	}
 	return QAccessibleWidget::interface_cast(type);
 }

@@ -355,26 +351,15 @@
 	return false; // A single-selection list always keeps one current item.
 }

-// Attributes. Reports the container's orientation (e.g. a vertical list) so UI
-// Automation can describe a horizontal/vertical orientation.
+// Attributes. Not reported: QAccessible::Attribute::Orientation is not yet
+// available in this Qt version (see patch header).

 QList<QAccessible::Attribute> Widget::attributeKeys() const {
-	auto result = QList<QAccessible::Attribute>();
-	if (rp()->accessibilityOrientation().has_value()) {
-		result.append(QAccessible::Attribute::Orientation);
-	}
-	return result;
+	return QList<QAccessible::Attribute>();
 }

 QVariant Widget::attributeValue(QAccessible::Attribute key) const {
-	if (key == QAccessible::Attribute::Orientation) {
-		if (const auto orientation = rp()->accessibilityOrientation()) {
-			// Plain int by design: the UIA bridge reads this back with
-			// QVariant::toInt(), and Qt::Orientation isn't a registered
-			// metatype here - QVariant::fromValue() of it wouldn't round-trip.
-			return int(*orientation);
-		}
-	}
+	Q_UNUSED(key);
 	return QVariant();
 }
